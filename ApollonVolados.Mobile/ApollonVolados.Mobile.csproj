<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The plain net10.0 target exists only so the unit-test project can reference the
		     app's models, services and view models. It is a library and is never shipped. -->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationId>com.apollonvolados.mobile</ApplicationId>
		<ApplicationTitle>Apollon Volados</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<ArchiveOnBuild>true</ArchiveOnBuild>
		<BuildIpa>true</BuildIpa>

		<CodesignKey>83E5262836814572AEF391636FD168643B570616</CodesignKey>
		<CodesignProvision>Automatic</CodesignProvision>
		<EnableCodeSigning>true</EnableCodeSigning>
	</PropertyGroup>

	<!-- Android-specific -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<!-- Minimum Android 8.0 (API 26). The target API comes from the .NET Android SDK (36). -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
		<RunAOTCompilation>true</RunAOTCompilation>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<!-- iOS-specific -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>		
		<IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
		<!-- Name of the MauiIcon (appicon.svg); without it actool compiles the icon but never assigns it -->
		<AppIcon>appicon</AppIcon>
	</PropertyGroup>

	<!-- MAUI Assets -->
	<ItemGroup>
		<!-- Adaptive icon: green background + crest foreground (safe-zone sized). MAUI renders every iOS/Android size. -->
		<MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appicon_fg.png" Color="#007A3D" />
		<MauiSplashScreen Include="Resources/Splash/appsplash.png" Color="#007A3D" Resize="false" />
		<MauiImage Include="Resources/Images/**/*" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ApollonVolados.Mobile.Tests" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

</Project>
