<?xml version="1.0" encoding="utf-8" ?>
<!-- History timeline: crest-ring nodes threaded on a green spine. -->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ApollonVolados.Mobile.ViewModels"
    xmlns:models="clr-namespace:ApollonVolados.Mobile.Models"
    x:Class="ApollonVolados.Mobile.Views.Controls.TimelineSection"
    x:DataType="vm:TimelineViewModel">

    <!-- BindableLayout, not CollectionView: this sits inside the page's ScrollView -->
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:TimelineEvent">
                <Grid ColumnDefinitions="24,*" Style="{StaticResource Grid.MediaRow}">
                    <Grid>
                        <BoxView Style="{StaticResource Timeline.Spine}" />
                        <Border Style="{StaticResource CrestDisc.Small}">
                            <Border Style="{StaticResource CrestDisc.Ring}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" Style="{StaticResource Stack.Text}" Padding="0,0,0,20">
                        <Label Text="{Binding Year}" Style="{StaticResource Text.Year}" />
                        <Label Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                        <Label Text="{Binding Description}" Style="{StaticResource Text.Subhead}" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
