<?xml version="1.0" encoding="utf-8" ?>
<!-- Milestone cards; major milestones carry the bronze hairline (Card.Milestone). -->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ApollonVolados.Mobile.ViewModels"
    xmlns:models="clr-namespace:ApollonVolados.Mobile.Models"
    x:Class="ApollonVolados.Mobile.Views.Controls.MilestonesSection"
    x:DataType="vm:MilestonesViewModel">

    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Style="{StaticResource Stack.Cards}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:Milestone">
                <Border Style="{StaticResource Card.Milestone}">
                    <Grid ColumnDefinitions="56,*" Style="{StaticResource Grid.MediaRow}">
                        <Label Text="{Binding Year}" Style="{StaticResource Text.Year}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Style="{StaticResource Stack.Text}">
                            <Label Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                            <Label Text="{Binding Description}" Style="{StaticResource Text.Subhead}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
