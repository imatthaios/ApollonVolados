<?xml version="1.0" encoding="utf-8" ?>
<!-- Placeholder with the same anatomy as a news row; pulses while visible. -->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ApollonVolados.Mobile.Views.Controls.SkeletonNewsItem">

    <Border Style="{StaticResource Card.Compact}">
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource Grid.MediaRow}">
            <Border Style="{StaticResource Thumbnail}" />
            <VerticalStackLayout Grid.Column="1" Style="{StaticResource Stack.Text}" Spacing="{StaticResource Space2}" VerticalOptions="Center">
                <BoxView Style="{StaticResource Skeleton}" />
                <BoxView Style="{StaticResource Skeleton}" WidthRequest="160" HorizontalOptions="Start" />
                <BoxView Style="{StaticResource Skeleton}" WidthRequest="80" HorizontalOptions="Start" HeightRequest="10" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
