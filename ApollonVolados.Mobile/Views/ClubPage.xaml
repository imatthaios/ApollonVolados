<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ApollonVolados.Mobile.ViewModels"
    xmlns:controls="clr-namespace:ApollonVolados.Mobile.Views.Controls"
    x:Class="ApollonVolados.Mobile.Views.ClubPage"
    x:DataType="vm:ClubViewModel"
    Title="Σύλλογος">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Stack.Page}">

            <!-- HEADER -->
            <VerticalStackLayout Style="{StaticResource Stack.Header}">
                <Border Style="{StaticResource CrestFrame.Small}" HorizontalOptions="Start">
                    <Image Source="crest.png" SemanticProperties.Description="Έμβλημα Απόλλων Βωλάδος" />
                </Border>
                <Label Text="ΑΘΛΗΤΙΚΟΣ ΣΥΛΛΟΓΟΣ" Style="{StaticResource Text.Overline}" />
                <Label Text="Απόλλων Βωλάδος" Style="{StaticResource Text.Title1}" SemanticProperties.HeadingLevel="Level1" />
                <controls:CrestRule />
                <Label Text="{Binding HistoryText}" Style="{StaticResource Text.Callout}" />
            </VerticalStackLayout>

            <!-- CLUB FACTS -->
            <VerticalStackLayout Style="{StaticResource Stack.Section}">
                <Label Text="Στοιχεία Συλλόγου" Style="{StaticResource Text.Title2}" SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Style="{StaticResource Stack.Section}">
                        <VerticalStackLayout Style="{StaticResource Stack.Text}">
                            <Label Text="Έτος ίδρυσης" Style="{StaticResource Text.Footnote}" />
                            <Label Text="1924" Style="{StaticResource Text.Year}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />
                        <VerticalStackLayout Style="{StaticResource Stack.Text}">
                            <Label Text="Έδρα" Style="{StaticResource Text.Footnote}" />
                            <Label Text="Δημοτικό Γήπεδο Βωλάδος" Style="{StaticResource Text.Headline}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />
                        <VerticalStackLayout Style="{StaticResource Stack.Text}">
                            <Label Text="Χρώματα" Style="{StaticResource Text.Footnote}" />
                            <Label Text="Πράσινο – Άσπρο" Style="{StaticResource Text.Headline}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- TIMELINE -->
            <VerticalStackLayout Style="{StaticResource Stack.Section}">
                <Label Text="Χρονολόγιο" Style="{StaticResource Text.Title2}" SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <controls:TimelineSection />
                </Border>
            </VerticalStackLayout>

            <!-- MILESTONES -->
            <VerticalStackLayout Style="{StaticResource Stack.Section}">
                <Label Text="Σημαντικοί σταθμοί" Style="{StaticResource Text.Title2}" SemanticProperties.HeadingLevel="Level2" />
                <controls:MilestonesSection />
            </VerticalStackLayout>

            <!-- APPEARANCE: Automatic / Light / Dark -->
            <VerticalStackLayout x:Name="AppearanceSection" x:DataType="vm:AppearanceViewModel" Style="{StaticResource Stack.Section}">
                <Label Text="Εμφάνιση" Style="{StaticResource Text.Title2}" SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource SegmentedControl}">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space1}">
                        <Button BindingContext="{Binding System}" x:DataType="vm:ThemeOption" Text="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource Button.Segment}" />
                        <Button Grid.Column="1" BindingContext="{Binding Light}" x:DataType="vm:ThemeOption" Text="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource Button.Segment}" />
                        <Button Grid.Column="2" BindingContext="{Binding Dark}" x:DataType="vm:ThemeOption" Text="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource Button.Segment}" />
                    </Grid>
                </Border>
                <Label Text="Το «Αυτόματο» ακολουθεί τη ρύθμιση του τηλεφώνου." Style="{StaticResource Text.Footnote}" />
            </VerticalStackLayout>

            <!-- CONTACT -->
            <VerticalStackLayout Style="{StaticResource Stack.Section}">
                <Label Text="Επικοινωνία" Style="{StaticResource Text.Title2}" SemanticProperties.HeadingLevel="Level2" />
                <Button Text="Τηλέφωνο" Style="{StaticResource Button.Primary}" Command="{Binding CallCommand}" />
                <Button Text="Email" Style="{StaticResource Button.Secondary}" Command="{Binding EmailCommand}" />
                <Button Text="Ιστοσελίδα" Style="{StaticResource Button.Secondary}" Command="{Binding WebsiteCommand}" />
                <Button Text="Χάρτης" Style="{StaticResource Button.Secondary}" Command="{Binding MapCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
