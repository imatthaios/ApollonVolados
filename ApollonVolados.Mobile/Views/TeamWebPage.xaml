<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ApollonVolados.Mobile.Views.TeamWebPage">

    <!-- Top bar (platform back affordance) / progress / content. No hard-coded safe-area margins. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Style="{StaticResource TopBar}">
            <Button Style="{StaticResource Button.Back}" Clicked="OnBackClicked" />
        </Grid>

        <ProgressBar x:Name="LoadingProgress" Grid.Row="1" IsVisible="False" />

        <WebView
            x:Name="Browser"
            Grid.Row="2" />
    </Grid>
</ContentPage>
