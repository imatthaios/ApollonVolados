<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ApollonVolados.Mobile.ViewModels"
    xmlns:models="clr-namespace:ApollonVolados.Mobile.Models"
    xmlns:controls="clr-namespace:ApollonVolados.Mobile.Views.Controls"
    x:Class="ApollonVolados.Mobile.Views.TeamsPage"
    x:DataType="vm:TeamsViewModel"
    Title="Τμήματα">

    <CollectionView
        ItemsSource="{Binding Categories}"
        SelectionMode="Single"
        SelectionChanged="OnSelectionChanged">

        <CollectionView.ItemsLayout>
            <GridItemsLayout
                Orientation="Vertical"
                Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                VerticalItemSpacing="{StaticResource Space3}"
                HorizontalItemSpacing="0" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Style="{StaticResource Stack.Header}" Margin="{StaticResource ListLeadItemMargin}">
                <Label Text="ΤΜΗΜΑΤΑ" Style="{StaticResource Text.Overline}" />
                <Label Text="Οι ομάδες μας" Style="{StaticResource Text.Title1}" SemanticProperties.HeadingLevel="Level1" />
                <controls:CrestRule />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:TeamCategory">
                <Border Style="{StaticResource Card}" Margin="{StaticResource ListItemMargin}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource Grid.MediaRow}">

                        <!-- Badge: green disc ringed in bronze (the crest ring) -->
                        <Border Style="{StaticResource CrestDisc}">
                            <Border Style="{StaticResource CrestDisc.Ring}">
                                <Label Text="{Binding Icon}" Style="{StaticResource CrestDisc.Glyph}" />
                            </Border>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Style="{StaticResource Stack.Text}" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource Text.Headline}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Text.Subhead}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2" Style="{StaticResource Text.Chevron}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="{StaticResource Space6}" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
