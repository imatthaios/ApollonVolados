<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ApollonVolados.Mobile.Views.AnimatedSplashPage"
    Style="{StaticResource Page.Splash}">

    <Grid>
        <!-- Soft light wave played over the crest -->
        <BoxView x:Name="LightOverlay" Color="{StaticResource CrestParchment}" Opacity="0" />

        <!-- Initial transform values are the animation's start state (see code-behind) -->
        <Border
            x:Name="LogoContainer"
            Style="{StaticResource CrestFrame.Splash}"
            Opacity="0"
            Scale="0.45"
            Rotation="-18">
            <Image x:Name="Logo" Source="crest.png" />
        </Border>
    </Grid>
</ContentPage>
