<?xml version="1.0" encoding="utf-8" ?>
<!--
    Design system for the "Heritage Editorial" direction. See docs/DESIGN.md.

    Order: tokens (fonts, spacing, radius, elevation) -> implicit control styles
    -> type scale (Text.*) -> components. Pages compose these styles; they do not
    set colours, fonts, sizes or radii inline.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ApollonVolados.Mobile.Models"
    xmlns:vm="clr-namespace:ApollonVolados.Mobile.ViewModels">

    <!-- ===================================================================== -->
    <!-- TOKENS                                                                -->
    <!-- ===================================================================== -->

    <!-- Platform serif with full Greek coverage; body text uses the system sans (no FontFamily). -->
    <OnPlatform x:Key="FontSerif" x:TypeArguments="x:String">
        <On Platform="iOS, MacCatalyst" Value="Georgia" />
        <On Platform="Android" Value="serif" />
    </OnPlatform>

    <!-- Back affordance differs by platform (§4) -->
    <OnPlatform x:Key="BackButtonText" x:TypeArguments="x:String">
        <On Platform="iOS, MacCatalyst" Value="‹ Πίσω" />
        <On Platform="Android" Value="←" />
    </OnPlatform>

    <!-- Spacing: 4-pt grid -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space12">48</x:Double>

    <Thickness x:Key="PagePadding">20,8,20,32</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CompactCardPadding">12</Thickness>
    <!-- List gutters live on the items (not the list) so card shadows aren't clipped by their cell -->
    <Thickness x:Key="ListItemMargin">20,0</Thickness>
    <Thickness x:Key="ListLeadItemMargin">20,0,20,16</Thickness>

    <!-- Elevation level 2: floating elements only, and never in dark mode -->
    <!-- Android gets no shadow: MAUI draws a Border's shadow there as a rectangle that ignores the
         rounded StrokeShape, so cards rely on their hairline instead (docs/DESIGN.md §3). -->
    <OnPlatform x:Key="ElevationLevel2" x:TypeArguments="Shadow">
        <On Platform="iOS, MacCatalyst">
            <Shadow Brush="#1A000000" Offset="0,6" Radius="18" />
        </On>
        <!-- Explicit invisible shadow: leaving Android out made Release (compiled XAML) fall back to the iOS shadow -->
        <On Platform="Android">
            <Shadow Brush="Transparent" Offset="0,0" Radius="0" Opacity="0" />
        </On>
    </OnPlatform>

    <!-- ===================================================================== -->
    <!-- IMPLICIT CONTROL STYLES                                               -->
    <!-- ===================================================================== -->

    <Style x:Key="Page.Base" TargetType="Page">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True" BasedOn="{StaticResource Page.Base}" />

    <!-- MAUI 10 pages are edge-to-edge by default; keep content clear of the status bar,
         Dynamic Island and tab bar on every page (the splash opts out with Page.Splash). -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True" BasedOn="{StaticResource Page.Base}">
        <Setter Property="SafeAreaEdges" Value="Container" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <!-- iOS draws its own (Liquid Glass) bar; Android uses this as the bottom-navigation surface -->
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="3" />
    </Style>

    <Style TargetType="WebView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <!-- ===================================================================== -->
    <!-- TYPE SCALE                                                            -->
    <!-- ===================================================================== -->

    <Style x:Key="Text.Body" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- Any Label without a Style is body text -->
    <Style TargetType="Label" BasedOn="{StaticResource Text.Body}" />

    <Style x:Key="Text.Display" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style x:Key="Text.Title1" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="Text.Title2" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style x:Key="Text.Title3" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style x:Key="Text.Headline" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Text.Callout" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="Text.Subhead" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="Text.Footnote" TargetType="Label" BasedOn="{StaticResource Text.Subhead}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="Label" BasedOn="{StaticResource Text.Subhead}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <!-- Write overline text in capitals WITHOUT accents (ΤΑ ΝΕΑ ΜΑΣ). TextTransform=Uppercase would
         keep the tonos (ΝΈΑ), which is wrong in Greek typography. -->
    <Style x:Key="Text.Overline" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
    </Style>

    <!-- Serif numerals in bronze, echoing "1924" on the crest -->
    <Style x:Key="Text.Year" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
    </Style>

    <Style x:Key="Text.Error" TargetType="Label" BasedOn="{StaticResource Text.Callout}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Chevron" TargetType="Label" BasedOn="{StaticResource Text.Title3}">
        <Setter Property="Text" Value="›" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- BUTTONS                                                               -->
    <!-- ===================================================================== -->

    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}" />

    <!-- Outlined: secondary actions next to a primary one -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Text-only: navigation affordances such as Back -->
    <Style x:Key="Button.Tertiary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="Button.Back" TargetType="Button" BasedOn="{StaticResource Button.Tertiary}">
        <Setter Property="Text" Value="{StaticResource BackButtonText}" />
        <Setter Property="FontSize" Value="{OnPlatform iOS=17, Android=28}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="SemanticProperties.Description" Value="Πίσω" />
    </Style>

    <!-- Segmented control (appearance switch): sunken track, selected segment lifts to Primary -->
    <Style x:Key="SegmentedControl" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="Button.Segment" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Style.Triggers>
            <DataTrigger TargetType="Button" Binding="{Binding IsSelected, x:DataType=vm:ThemeOption}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== -->
    <!-- SURFACES                                                              -->
    <!-- ===================================================================== -->

    <!-- Elevation level 1: surface + hairline, no shadow -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="Card.Compact" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
    </Style>

    <!-- Elevation level 2: the lead news story -->
    <Style x:Key="Card.Lead" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource ElevationLevel2}, Dark={x:Null}}" />
    </Style>

    <!-- Major milestones get the bronze hairline -->
    <Style x:Key="Card.Milestone" TargetType="Border" BasedOn="{StaticResource Card.Compact}">
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsMajor, x:DataType=models:Milestone}" Value="True">
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineGoldLight}, Dark={StaticResource HairlineGoldDark}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Image well for thumbnails -->
    <Style x:Key="Thumbnail" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="WidthRequest" Value="88" />
        <Setter Property="HeightRequest" Value="88" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="Image.Cover" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" />
    </Style>

    <Style x:Key="Image.LeadCover" TargetType="Image" BasedOn="{StaticResource Image.Cover}">
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=200, Tablet=280}" />
    </Style>

    <Style x:Key="Skeleton" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HeightRequest" Value="14" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <!-- Top bar for pushed (WebView) pages -->
    <Style x:Key="TopBar" TargetType="Grid">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- LAYOUT                                                                -->
    <!-- ===================================================================== -->

    <Style x:Key="Stack.Page" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="{StaticResource Space8}" />
    </Style>

    <Style x:Key="Stack.Section" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource Space3}" />
    </Style>

    <Style x:Key="Stack.Header" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource Space2}" />
        <Setter Property="Padding" Value="0,16,0,8" />
    </Style>

    <Style x:Key="Stack.Text" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource Space1}" />
    </Style>

    <Style x:Key="Stack.Cards" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource Space3}" />
    </Style>

    <Style x:Key="Grid.MediaRow" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource Space4}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- SIGNATURE: THE CREST RING (docs/DESIGN.md §5)                         -->
    <!-- ===================================================================== -->

    <!-- Crest rule: 3-px green bar + bronze hairline -->
    <Style x:Key="CrestRule.Bar" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="HeightRequest" Value="3" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CrestRule.Line" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineGoldLight}, Dark={StaticResource HairlineGoldDark}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Green disc ringed in bronze: team badges (large) and timeline nodes (small) -->
    <Style x:Key="CrestDisc" TargetType="Border">
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource CrestGreen}" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CrestDisc.Small" TargetType="Border" BasedOn="{StaticResource CrestDisc}">
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="CrestDisc.Ring" TargetType="Border">
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineGoldLight}, Dark={StaticResource SecondaryDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CrestDisc.Glyph" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Timeline spine threading the nodes -->
    <Style x:Key="Timeline.Spine" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="WidthRequest" Value="2" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <!-- The crest inside a bronze hairline ring -->
    <Style x:Key="CrestFrame" TargetType="Border">
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineGoldLight}, Dark={StaticResource HairlineGoldDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="WidthRequest" Value="168" />
        <Setter Property="HeightRequest" Value="168" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="CrestFrame.Small" TargetType="Border" BasedOn="{StaticResource CrestFrame}">
        <Setter Property="WidthRequest" Value="120" />
        <Setter Property="HeightRequest" Value="120" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Splash: parchment disc on crest green, floating -->
    <Style x:Key="CrestFrame.Splash" TargetType="Border" BasedOn="{StaticResource CrestFrame}">
        <Setter Property="Stroke" Value="{StaticResource HairlineGoldLight}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="BackgroundColor" Value="{StaticResource CrestParchment}" />
        <Setter Property="WidthRequest" Value="210" />
        <Setter Property="HeightRequest" Value="210" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Shadow" Value="{StaticResource ElevationLevel2}" />
    </Style>

    <Style x:Key="Page.Splash" TargetType="ContentPage" BasedOn="{StaticResource Page.Base}">
        <Setter Property="BackgroundColor" Value="{StaticResource CrestGreen}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

</ResourceDictionary>
