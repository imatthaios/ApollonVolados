<?xml version="1.0" encoding="utf-8" ?>
<!--
    Colour tokens for the "Heritage Editorial" direction (docs/DESIGN.md §3).
    Every role has a Light and a Dark value; Styles.xaml picks between them with
    AppThemeBinding. Pages never reference these directly - they use styles.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary: crest green -->
    <Color x:Key="PrimaryLight">#007A3D</Color>
    <Color x:Key="PrimaryDark">#4CC285</Color>
    <Color x:Key="PrimaryStrongLight">#0B4F2C</Color>
    <Color x:Key="PrimaryStrongDark">#8FDDB2</Color>
    <Color x:Key="PrimaryContainerLight">#E3F1E8</Color>
    <Color x:Key="PrimaryContainerDark">#13392A</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#04210F</Color>

    <!-- Secondary: crest bronze -->
    <Color x:Key="SecondaryLight">#8A6324</Color>
    <Color x:Key="SecondaryDark">#D9B36C</Color>
    <Color x:Key="HairlineGoldLight">#C9A24A</Color>
    <Color x:Key="HairlineGoldDark">#8C7240</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundLight">#FAF7F0</Color>
    <Color x:Key="BackgroundDark">#0E1612</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#16211B</Color>
    <Color x:Key="SurfaceSunkenLight">#F2EEE4</Color>
    <Color x:Key="SurfaceSunkenDark">#1E2B24</Color>
    <Color x:Key="OutlineLight">#E7E1D3</Color>
    <Color x:Key="OutlineDark">#2A3830</Color>

    <!-- Text (ink) -->
    <Color x:Key="TextPrimaryLight">#1B1F1C</Color>
    <Color x:Key="TextPrimaryDark">#F2EFE6</Color>
    <Color x:Key="TextSecondaryLight">#5B625D</Color>
    <Color x:Key="TextSecondaryDark">#A9B3AC</Color>
    <Color x:Key="TextTertiaryLight">#8A8F8A</Color>
    <Color x:Key="TextTertiaryDark">#76807A</Color>

    <!-- Semantic -->
    <Color x:Key="ErrorLight">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>
    <Color x:Key="WarningLight">#8F5A00</Color>
    <Color x:Key="WarningDark">#F3C26B</Color>

    <!-- Fixed (theme-independent) -->
    <Color x:Key="CrestGreen">#007A3D</Color>
    <Color x:Key="CrestParchment">#FFFEFB</Color>
    <Color x:Key="ShadowColor">#1A000000</Color>

</ResourceDictionary>
